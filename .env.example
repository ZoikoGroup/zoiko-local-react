# Base URL of the Zoiko Local backend. The assistant widget calls
# ${NEXT_PUBLIC_API_URL}/api/v1/assistant, so this must be the API origin
# (no trailing slash, no /api/v1 suffix). Local backend: `make dev` in
# zoiko-local-platform runs it on :8010. Production: the deployed API origin.
NEXT_PUBLIC_API_URL=http://localhost:8010
